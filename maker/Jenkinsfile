pipeline {
    agent any

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-cred'
        DOCKER_IMAGE          = 'hithatreesathomas/maker' // Format: username/maker
        SONAR_SERVER_NAME     = 'sonarqube-env' 
        SONAR_SCANNER_TOOL    = 'sonar-scanner'     
        GIT_CREDENTIALS_ID    = 'github-cred'
        MANIFEST_REPO         = 'https://github.com/hithatreesa/docker-maker.git'
        MANIFEST_BRANCH       = 'main'
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                //checkout scm
                echo "passed"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool "${SONAR_SCANNER_TOOL}"
                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {
                        sh "${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=docker-maker-key \
                            -Dsonar.projectName='docker-maker-project' \
                            -Dsonar.sources=."
                    }
                }
            }
        }

         stage('Build & Post Docker Image') {
    steps {
        script {
            withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                sh """
                    echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                    
                    docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest -f maker/Dockerfile maker
                    
                    docker push ${DOCKER_IMAGE}:${env.BUILD_NUMBER}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
        }
    }
}

      stage('Update Manifest Repo') {
    steps {
        dir('manifest-workspace') {
            withCredentials([
                usernamePassword(
                    credentialsId: 'github-cred',
                    usernameVariable: 'GH_USER',
                    passwordVariable: 'GH_TOKEN'
                )
            ]) {
                sh """
                    git remote set-url origin https://\${GH_USER}:\${GH_TOKEN}@github.com/hithatreesa/docker-maker.git

                    git pull --rebase origin main

                    sed -i '/name: maker/{n;s|image:.*|image: hithatreesathomas/maker:${env.BUILD_NUMBER}|}' maker/manifests/deployment.yaml

                    git config user.name "Jenkins CI"
                    git config user.email "YOUR_GITHUB_EMAIL"

                    git add maker/manifests/deployment.yaml

                    git commit -m "Update maker image to ${env.BUILD_NUMBER} [skip ci]"

                    git push origin main
                """
            }
        }
    }
}
        
    post {
        success {
            echo 'Pipeline executed successfully! Manifest repo updated with new image tag.'
        }
        failure {
            echo 'Pipeline failed. Please review the stage logs above.'
        }
    }
}
