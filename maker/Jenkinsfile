pipeline {
    agent any

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-cred'
        DOCKER_IMAGE          = 'hithatreesathomas/maker' // Format: username/maker
        SONAR_SERVER_NAME     = 'sonarqube-env' 
        SONAR_SCANNER_TOOL    = 'SonarScanner'     
        GIT_CREDENTIALS_ID    = 'github-cred'
        MANIFEST_REPO         = 'https://github.com/hithatreesa/docker-maker.git'
        MANIFEST_BRANCH       = 'main'
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                //checkout scm
                echo "passed"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool "${SONAR_SCANNER_TOOL}"
                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {
                        sh "${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=docker-maker-key \
                            -Dsonar.projectName='docker-maker-project' \
                            -Dsonar.sources=."
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        // Builds and pushes your-dockerhub-username/maker:<BUILD_NUMBER> and :latest
                        def appImage = docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}")
                        appImage.build()
                        appImage.push()
                        appImage.push('latest')
                    }
                }
            }
        }

        stage('Update Manifest Repo') {
            steps {
                dir('manifest-workspace') {
                    git branch: "${MANIFEST_BRANCH}", credentialsId: "${GIT_CREDENTIALS_ID}", url: "${MANIFEST_REPO}"

                    sh """
                        # Updates the 'maker' container image tag to your-dockerhub-username/maker:<BUILD_NUMBER>
                        sed -i '/name: maker/{n;s|image:.*|image: ${DOCKER_IMAGE}:${env.BUILD_NUMBER}|}' k8s/deployment.yaml
                        
                        git -c user.name='Jenkins CI' -c user.email='jenkins@ci.local' commit -am "chore(manifest): update maker image tag to ${env.BUILD_NUMBER} [skip ci]"
                        git push origin ${MANIFEST_BRANCH}
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully! Manifest repo updated with new image tag.'
        }
        failure {
            echo 'Pipeline failed. Please review the stage logs above.'
        }
    }
}